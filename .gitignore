# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]

# C extensions
*.so

# Distribution / packaging
.Python
env/
venv
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Go
/src/dongled
/src/bin/
/src/coverage.out
/src/**/*.test
*.db
*.db-wal
*.db-shm

# Node / Vite
node_modules/
/src/web/dist/
/src/web/.vite/
/src/web/*.tsbuildinfo
/src/internal/webui/dist/assets/

# The embedded SPA placeholder is tracked on purpose: //go:embed is compile-time.
!/src/internal/webui/dist/
!/src/internal/webui/dist/index.html
!/src/internal/webui/dist/.gitkeep
